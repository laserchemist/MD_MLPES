NAME = ch2oo_eq_qdnevpt2.inp
|  1> # CH2OO, SA4-CASSCF(8,6)/cc-pVDZ, singlet A' (Cs), + SC-NEVPT2 and QD-NEVPT2 (van Vleck)
|  2> # Same level as the diabml data (PySCF): all electrons correlated (NoFrozenCore), as PySCF's NEVPT2 does.
|  3> ! cc-pVDZ NoFrozenCore UseSym TightSCF
|  4> %maxcore 2000
|  5> %casscf
|  6>   nel    8
|  7>   norb   6
|  8>   mult   1
|  9>   irrep  0          # A' in Cs
| 10>   nroots 4
| 11>   PTMethod SC_NEVPT2
| 12>   PTSettings
| 13>     QDType QD_VanVleck
| 14>   end
| 15> end
| 16> 
| 17> * xyz 0 1
| 18> C     -1.272000     0.000000     0.000000
